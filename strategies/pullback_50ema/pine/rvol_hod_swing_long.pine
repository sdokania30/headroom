//@version=6
// =============================================================================
// RVOL ORB Swing — Long Only
// -----------------------------------------------------------------------------
// Apply to a 5-MINUTE chart.
//
//   Opening range : first 5 minutes of the session (bar 1)
//   Entry window  : first 15 minutes  (bars 2 and 3 are fillable)
//   RVOL gate     : cumulative session volume >= 9% of the 20-day ADV
//
// Entry — all three must hold:
//   1. Optional 4H 50-EMA pullback setup is live (trend + separation + >=2
//      counter-trend bars that respect the EMA + breakout of the first
//      pullback bar's high).
//   2. The RVOL gate has latched on a bar that has already CLOSED.
//   3. A buy-stop 1 tick above the opening-range high fills, on a bar that
//      opens at or after the end of the opening range and before the end of
//      the entry window.
//
// On a 5-min chart that gives two chances to fill: 09:20-09:25 (needs the RVOL
// to latch on bar 1) and 09:25-09:30 (needs it by bar 2's close). After 09:30
// any working order is cancelled and the day is done.
//
// Exit: an intraday close through the Chandelier Exit line (computed on the
// daily timeframe by default — see the note on `chandTF`), plus an optional
// ATR initial stop that covers the trade before the trail is meaningful.
//
// Non-repainting: every higher-timeframe value is fetched with
// barmerge.lookahead_off, and the 4H state machine is advanced only when a 4H
// bar has CLOSED, using that closed bar's OHLC.
// =============================================================================

strategy("RVOL ORB Swing (Long)", shorttitle="RVOL-ORB Long", overlay=true,
     initial_capital        = 1000000,
     default_qty_type       = strategy.percent_of_equity,
     default_qty_value      = 100,
     pyramiding             = 0,
     margin_long            = 100,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.03,
     slippage               = 2,
     calc_on_every_tick     = false,
     process_orders_on_close = false,
     max_labels_count       = 500,
     max_lines_count        = 500)

// ----------------------------------------------------------------------------
// Inputs
// ----------------------------------------------------------------------------
gSess = "Session, opening range & entry window"
sessTime    = input.session("0915-1530", "Regular session", group = gSess,
     tooltip = "NSE cash is 0915-1530 IST. Set the chart timezone to match.")
orMinutes   = input.int(5, "Opening range (minutes)", minval = 1, maxval = 240, group = gSess,
     tooltip = "The breakout level is 1 tick above the high of this range. On a 5-min chart, 5 = the first bar.")
entryWindow = input.int(15, "Entry window from the open (minutes)", minval = 2, maxval = 375, group = gSess,
     tooltip = "The order may only be WORKING inside this window. Must be longer than the opening range. On a 5-min chart, 15 leaves two fillable bars.")

gFilt = "Opening-range quality filter"
maxOrAtr = input.float(0.0, "Max opening-range width (x daily ATR, 0 = off)", minval = 0.0, step = 0.1,
     group = gFilt,
     tooltip = "On a gap-up the first bar can be enormous, which puts the buy-stop above an already-extended high and the initial stop far below it. Set to e.g. 1.0 to skip those days.")

gRvol = "RVOL gate"
advLen     = input.int(20, "ADV lookback (days)", minval = 1, group = gRvol)
rvolPct    = input.float(9.0, "Cumulative volume as % of ADV", minval = 0.1, step = 0.5, group = gRvol,
     tooltip = "Session volume accumulated so far, as a share of the 20-day average daily volume.")
rvolMinutes = input.int(15, "RVOL measurement window (minutes)", minval = 1, maxval = 375, group = gRvol,
     tooltip = "The gate can only latch inside this window. Set to 10 to restore the original 'RVOL within 10 minutes' rule.")

gH4 = "4H 50-EMA pullback filter"
useH4     = input.bool(true, "Require the 4H pullback setup", group = gH4)
h4TF      = input.timeframe("240", "Setup timeframe", group = gH4)
emaLen    = input.int(50, "EMA length", minval = 1, group = gH4)
atrLenH4  = input.int(14, "ATR length", minval = 1, group = gH4)
trendBars = input.int(3, "Bars to confirm the trend", minval = 1, group = gH4)
sepATR    = input.float(1.0, "Minimum separation from EMA (x ATR)", minval = 0.0, step = 0.1, group = gH4)
minPB     = input.int(2, "Minimum counter-trend bars", minval = 1, group = gH4)
maxPB     = input.int(6, "Maximum counter-trend bars", minval = 1, group = gH4)
validBars = input.int(6, "Setup stays valid for (4H bars)", minval = 1, group = gH4,
     tooltip = "Applies to both an armed-but-unfilled trigger and a setup that has already broken out.")

gExit = "Exit"
chandTF     = input.timeframe("D", "Chandelier timeframe", group = gExit,
     tooltip = "Leave on D for a swing trail. 22 bars on a 5-min chart is 110 minutes, which is a day-trade stop, not a swing stop. Set to an empty string to use the chart timeframe.")
chandLen    = input.int(22, "Chandelier lookback", minval = 1, group = gExit)
chandMult   = input.float(3.0, "Chandelier ATR multiple", minval = 0.1, step = 0.1, group = gExit)
ratchet     = input.bool(true, "Ratchet the trail (never let it fall)", group = gExit)
useInitStop = input.bool(true, "Initial ATR stop", group = gExit)
initATR     = input.float(1.5, "Initial stop (x ATR)", minval = 0.1, step = 0.1, group = gExit)
eodExit     = input.bool(false, "Force flat at the session close", group = gExit,
     tooltip = "Off by default. This is a swing strategy; positions are meant to be held overnight.")

gTrade = "Backtest visuals"
showSignals = input.bool(true, "BUY / SELL labels", group = gTrade)
showPnl     = input.bool(true, "Show profit booked on each exit", group = gTrade)
showConnect = input.bool(true, "Connect entry to exit", group = gTrade)
showStats   = input.bool(true, "Performance summary table", group = gTrade)
showLog     = input.bool(true, "Recent trades log", group = gTrade)
logRows     = input.int(10, "Trades to list", minval = 1, maxval = 30, group = gTrade)

gViz = "Display"
showEma    = input.bool(true, "Plot the 4H 50 EMA", group = gViz)
showLevels = input.bool(true, "Plot the opening range, entry stop and trail", group = gViz)
showTable  = input.bool(true, "Show the status table", group = gViz)

// ----------------------------------------------------------------------------
// Session, opening range and window arithmetic
// ----------------------------------------------------------------------------
inSess  = not na(time(timeframe.period, sessTime))
newSess = inSess and not inSess[1]
tfMins  = timeframe.in_seconds(timeframe.period) / 60.0

var int   sessOpenTime = na
var float cumVol       = na
var float orHigh       = na
var float orLow        = na
var bool  rvolOK       = false
var bool  tradedToday  = false

if newSess
    sessOpenTime := time
    cumVol       := 0.0
    orHigh       := na
    orLow        := na
    rvolOK       := false
    tradedToday  := false

// Minutes from the session open to THIS bar's open, and to its close.
minsFromOpen = inSess and not na(sessOpenTime) ? (time - sessOpenTime) / 60000.0 : na
nextOffset   = minsFromOpen + tfMins

inOR       = inSess and not na(minsFromOpen) and minsFromOpen < orMinutes
inEntryWin = inSess and not na(minsFromOpen) and minsFromOpen < entryWindow
inRvolWin  = inSess and not na(minsFromOpen) and minsFromOpen < rvolMinutes

if inSess
    cumVol := nz(cumVol) + volume
if inOR
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow)  ? low  : math.min(orLow, low)

// The order may be placed at this bar's close only while the NEXT bar is a
// legal fill bar: it opens at or after the end of the opening range, and
// before the end of the entry window.
orderMayWork = inSess and not na(minsFromOpen) and nextOffset >= orMinutes and nextOffset < entryWindow

// ----------------------------------------------------------------------------
// RVOL gate: cumulative session volume as a share of the 20-day ADV
// ----------------------------------------------------------------------------
// [1] excludes today's own (incomplete) daily bar from the average.
adv = request.security(syminfo.tickerid, "D", ta.sma(volume, advLen)[1], lookahead = barmerge.lookahead_off)

rvolShare = na(adv) or adv <= 0 ? na : nz(cumVol) / adv
if inRvolWin and not na(rvolShare) and rvolShare >= rvolPct / 100.0
    rvolOK := true

// ----------------------------------------------------------------------------
// 4H 50-EMA pullback state machine (long side only)
// ----------------------------------------------------------------------------
// Simple built-ins only inside request.security; the state machine itself runs
// at chart scope and steps forward once per CLOSED 4H bar.
[h4Time, h4Open, h4High, h4Close, h4Ema, h4Atr] = request.security(syminfo.tickerid, h4TF,
     [time, open, high, close, ta.ema(close, emaLen), ta.atr(atrLenH4)],
     lookahead = barmerge.lookahead_off)

newH4 = ta.change(h4Time) != 0

var int   runSide     = 0     // +1 closing above the EMA, -1 below
var int   runLen      = 0
var float runSep      = 0.0   // peak |close - ema| / ATR reached during the run
var int   pbCount     = 0     // consecutive counter-trend bars in the live pullback
var float pbFirstHigh = na
var float h4Trigger   = na    // armed breakout level
var int   sinceArm    = 0
var int   sinceTrig   = na    // 4H bars since the last breakout
var bool  h4Ready     = false

// The bar that just closed is the previous chart-bar's view of the HTF series.
if newH4 and not na(h4Close[1]) and not na(h4Ema[1]) and not na(h4Atr[1]) and h4Atr[1] > 0
    float o = h4Open[1]
    float h = h4High[1]
    float c = h4Close[1]
    float e = h4Ema[1]
    float a = h4Atr[1]

    int side     = c > e ? 1 : c < e ? -1 : 0
    int prevSide = runSide
    if side != 0 and side == runSide
        runLen += 1
    else
        runSide := side
        runLen  := side != 0 ? 1 : 0
        runSep  := 0.0
    if side != 0
        runSep := math.max(runSep, math.abs(c - e) / a)
    bool flippedDown = side == -1 and prevSide == 1

    bool fired = false
    bool kill  = false

    if not na(h4Trigger) and h >= h4Trigger
        // Breakout of the pullback: a resting stop fills intrabar.
        fired := true
        kill  := true
    else if flippedDown
        // Closed to the wrong side of the 50 EMA.
        kill := true
    else if c < o
        // Counter-trend (red) bar inside the uptrend.
        if math.max(o, c) < e
            // Body entirely below the EMA — "gone through the 50 EMA, cancelled".
            kill := true
        else
            if pbCount == 0
                if runSide == 1 and runLen >= trendBars and runSep >= sepATR
                    pbCount     := 1
                    pbFirstHigh := h
            else
                pbCount += 1
            if pbCount > maxPB
                kill := true
            else if pbCount >= minPB and not na(pbFirstHigh)
                h4Trigger := pbFirstHigh + syminfo.mintick
                sinceArm  := 0
    else
        // Trend-direction bar: the counter-trend sequence is over.
        if pbCount > 0 and na(h4Trigger)
            pbCount     := 0
            pbFirstHigh := na
        else if not na(h4Trigger)
            sinceArm += 1
            if sinceArm > validBars
                kill := true

    if kill
        pbCount     := 0
        pbFirstHigh := na
        h4Trigger   := na
        sinceArm    := 0

    if fired
        sinceTrig := 0
    else if not na(sinceTrig)
        sinceTrig := sinceTrig + 1

    h4Ready := (not na(h4Trigger)) or (not na(sinceTrig) and sinceTrig <= validBars)

h4Gate = not useH4 or h4Ready

// ----------------------------------------------------------------------------
// Daily ATR and the Chandelier line (used by the OR-width filter and the exit)
// ----------------------------------------------------------------------------
[chandRaw, atrExit] = request.security(syminfo.tickerid, chandTF == "" ? timeframe.period : chandTF,
     [ta.highest(high, chandLen) - chandMult * ta.atr(chandLen), ta.atr(chandLen)],
     lookahead = barmerge.lookahead_off)

// ----------------------------------------------------------------------------
// Entry: buy-stop 1 tick above the opening-range high
// ----------------------------------------------------------------------------
badConfig  = entryWindow <= orMinutes
orWidth    = na(orHigh) or na(orLow) ? na : orHigh - orLow
orWidthOK  = maxOrAtr <= 0 or na(atrExit) or na(orWidth) or orWidth <= maxOrAtr * atrExit
entryStop  = na(orHigh) ? na : orHigh + syminfo.mintick
canWork    = orderMayWork and not badConfig and rvolOK and h4Gate and orWidthOK and
             strategy.position_size == 0 and not tradedToday and not na(entryStop)

if canWork
    strategy.entry("Long", strategy.long, stop = entryStop, comment = "RVOL+ORB")
else
    strategy.cancel("Long")

justEntered = strategy.position_size > 0 and strategy.position_size[1] == 0
if justEntered
    tradedToday := true

// ----------------------------------------------------------------------------
// Exit: Chandelier close-through, plus an optional ATR initial stop
// ----------------------------------------------------------------------------
var float trail    = na
var float initStop = na

if justEntered
    trail    := chandRaw
    initStop := useInitStop and not na(atrExit) ? strategy.position_avg_price - initATR * atrExit : na
else if strategy.position_size > 0
    trail := na(trail) ? chandRaw : (ratchet ? math.max(trail, chandRaw) : chandRaw)
else
    trail    := na
    initStop := na

if strategy.position_size > 0
    if not na(initStop)
        strategy.exit("Init stop", from_entry = "Long", stop = initStop)
    if not na(trail) and close < trail
        strategy.close("Long", comment = "Chandelier")
    else if eodExit and session.islastbar
        strategy.close("Long", comment = "EOD")

// ----------------------------------------------------------------------------
// Display
// ----------------------------------------------------------------------------
plot(showEma ? h4Ema : na, "4H 50 EMA", color.new(color.orange, 0), linewidth = 2)
plot(showLevels and inSess ? orHigh : na, "OR high", color.new(color.blue, 20), style = plot.style_linebr)
plot(showLevels and inSess ? orLow  : na, "OR low",  color.new(color.blue, 60), style = plot.style_linebr)
plot(showLevels and canWork ? entryStop : na, "Entry stop", color.new(color.teal, 0),
     style = plot.style_linebr, linewidth = 2)
plot(showLevels and strategy.position_size > 0 ? trail : na, "Chandelier", color.new(color.red, 0),
     style = plot.style_linebr, linewidth = 2)
plot(showLevels and strategy.position_size > 0 ? initStop : na, "Initial stop", color.new(color.maroon, 40),
     style = plot.style_linebr)

bgcolor(inOR ? color.new(color.blue, 85) : inEntryWin ? color.new(color.blue, 93) : na, title = "OR / entry window")
bgcolor(inEntryWin and rvolOK ? color.new(color.green, 82) : na, title = "RVOL breached")

plotshape(justEntered, "Entry", shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.tiny)

var table info = table.new(position.top_right, 2, 7, border_width = 1)
if showTable and barstate.islast
    table.cell(info, 0, 0, "RVOL (session / ADV)", text_halign = text.align_left, text_size = size.small)
    table.cell(info, 1, 0, na(rvolShare) ? "n/a" : str.tostring(rvolShare * 100, "#.##") + "%",
         text_size = size.small, bgcolor = rvolOK ? color.new(color.green, 70) : color.new(color.red, 80))
    table.cell(info, 0, 1, "Threshold", text_halign = text.align_left, text_size = size.small)
    table.cell(info, 1, 1, str.tostring(rvolPct, "#.##") + "%", text_size = size.small)
    table.cell(info, 0, 2, "OR high (" + str.tostring(orMinutes) + "m)", text_halign = text.align_left, text_size = size.small)
    table.cell(info, 1, 2, na(orHigh) ? "-" : str.tostring(orHigh, format.mintick), text_size = size.small)
    table.cell(info, 0, 3, "4H setup", text_halign = text.align_left, text_size = size.small)
    table.cell(info, 1, 3, not useH4 ? "off" : h4Ready ? "ready" : "none", text_size = size.small,
         bgcolor = h4Gate ? color.new(color.green, 70) : color.new(color.red, 80))
    table.cell(info, 0, 4, "4H trigger", text_halign = text.align_left, text_size = size.small)
    table.cell(info, 1, 4, na(h4Trigger) ? "-" : str.tostring(h4Trigger, format.mintick), text_size = size.small)
    table.cell(info, 0, 5, "OR width", text_halign = text.align_left, text_size = size.small)
    table.cell(info, 1, 5, na(orWidth) ? "-" : str.tostring(orWidth, format.mintick) +
         (maxOrAtr > 0 ? (orWidthOK ? "  ok" : "  too wide") : ""), text_size = size.small,
         bgcolor = maxOrAtr > 0 and not orWidthOK ? color.new(color.red, 70) : na)
    table.cell(info, 0, 6, "Entry window (" + str.tostring(entryWindow) + "m)", text_halign = text.align_left, text_size = size.small)
    table.cell(info, 1, 6, badConfig ? "BAD CONFIG" : inEntryWin ? "open" : "closed", text_size = size.small,
         bgcolor = badConfig ? color.new(color.red, 50) : na)

// ----------------------------------------------------------------------------
// Backtest visuals: BUY / SELL markers, profit booked, and the summary tables
// ----------------------------------------------------------------------------
if showSignals and justEntered
    label.new(bar_index, low, "BUY\n" + str.tostring(strategy.position_avg_price, format.mintick),
         xloc      = xloc.bar_index,
         yloc      = yloc.belowbar,
         style     = label.style_label_up,
         color     = color.new(color.teal, 10),
         textcolor = color.white,
         size      = size.small)

tradeClosed = strategy.closedtrades > nz(strategy.closedtrades[1])
if tradeClosed
    int    ti   = strategy.closedtrades - 1
    float  pnl  = strategy.closedtrades.profit(ti)
    float  ep   = strategy.closedtrades.entry_price(ti)
    float  xp   = strategy.closedtrades.exit_price(ti)
    int    ebar = strategy.closedtrades.entry_bar_index(ti)
    int    xbar = strategy.closedtrades.exit_bar_index(ti)
    string rsn  = strategy.closedtrades.exit_id(ti)
    float  pct  = ep != 0 ? (xp - ep) / ep * 100.0 : 0.0
    bool   win  = pnl >= 0

    if showSignals
        string txt = "SELL " + str.tostring(xp, format.mintick)
        if showPnl
            txt := txt + "\n" + (win ? "+" : "") + str.tostring(pnl, "#.##") +
                 "  (" + (win ? "+" : "") + str.tostring(pct, "#.##") + "%)"
            txt := txt + "\n" + (na(rsn) ? "exit" : rsn)
        label.new(xbar, high, txt,
             xloc      = xloc.bar_index,
             yloc      = yloc.abovebar,
             style     = label.style_label_down,
             color     = win ? color.new(color.green, 10) : color.new(color.red, 10),
             textcolor = color.white,
             size      = size.small)

    if showConnect
        line.new(ebar, ep, xbar, xp,
             xloc  = xloc.bar_index,
             color = win ? color.new(color.green, 30) : color.new(color.red, 30),
             width = 1,
             style = line.style_dashed)

f_money(x) => (x >= 0 ? "" : "-") + str.tostring(math.abs(x), "#,###.##")

var table stats = table.new(position.bottom_right, 2, 9, border_width = 1)
if showStats and barstate.islast
    int   tot  = strategy.closedtrades
    int   wins = strategy.wintrades
    int   loss = strategy.losstrades
    float wr   = tot > 0 ? wins / tot * 100.0 : 0.0
    float pf   = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    float avgW = wins > 0 ? strategy.grossprofit / wins : 0.0
    float avgL = loss > 0 ? strategy.grossloss / loss : 0.0
    float ret  = strategy.initial_capital > 0 ? strategy.netprofit / strategy.initial_capital * 100.0 : 0.0

    table.cell(stats, 0, 0, "PERFORMANCE", text_halign = text.align_left, text_size = size.small,
         bgcolor = color.new(color.gray, 60), text_color = color.white)
    table.cell(stats, 1, 0, "", bgcolor = color.new(color.gray, 60))
    table.cell(stats, 0, 1, "Net profit", text_halign = text.align_left, text_size = size.small)
    table.cell(stats, 1, 1, f_money(strategy.netprofit), text_size = size.small,
         bgcolor = strategy.netprofit >= 0 ? color.new(color.green, 70) : color.new(color.red, 70))
    table.cell(stats, 0, 2, "Return on capital", text_halign = text.align_left, text_size = size.small)
    table.cell(stats, 1, 2, str.tostring(ret, "#.##") + "%", text_size = size.small)
    table.cell(stats, 0, 3, "Closed trades", text_halign = text.align_left, text_size = size.small)
    table.cell(stats, 1, 3, str.tostring(tot), text_size = size.small)
    table.cell(stats, 0, 4, "Win rate", text_halign = text.align_left, text_size = size.small)
    table.cell(stats, 1, 4, str.tostring(wr, "#.#") + "%  (" + str.tostring(wins) + "W / " + str.tostring(loss) + "L)",
         text_size = size.small)
    table.cell(stats, 0, 5, "Profit factor", text_halign = text.align_left, text_size = size.small)
    table.cell(stats, 1, 5, na(pf) ? "n/a" : str.tostring(pf, "#.##"), text_size = size.small)
    table.cell(stats, 0, 6, "Avg win / avg loss", text_halign = text.align_left, text_size = size.small)
    table.cell(stats, 1, 6, f_money(avgW) + " / " + f_money(avgL), text_size = size.small)
    table.cell(stats, 0, 7, "Max drawdown", text_halign = text.align_left, text_size = size.small)
    table.cell(stats, 1, 7, f_money(strategy.max_drawdown), text_size = size.small)
    table.cell(stats, 0, 8, "Open P&L", text_halign = text.align_left, text_size = size.small)
    table.cell(stats, 1, 8, f_money(strategy.openprofit), text_size = size.small,
         bgcolor = strategy.openprofit >= 0 ? color.new(color.green, 80) : color.new(color.red, 80))

var table blotter = table.new(position.bottom_left, 5, logRows + 1, border_width = 1)
if showLog and barstate.islast and strategy.closedtrades > 0
    table.cell(blotter, 0, 0, "#",     text_size = size.tiny, bgcolor = color.new(color.gray, 60), text_color = color.white)
    table.cell(blotter, 1, 0, "Entry", text_size = size.tiny, bgcolor = color.new(color.gray, 60), text_color = color.white)
    table.cell(blotter, 2, 0, "Exit",  text_size = size.tiny, bgcolor = color.new(color.gray, 60), text_color = color.white)
    table.cell(blotter, 3, 0, "P&L",   text_size = size.tiny, bgcolor = color.new(color.gray, 60), text_color = color.white)
    table.cell(blotter, 4, 0, "Why",   text_size = size.tiny, bgcolor = color.new(color.gray, 60), text_color = color.white)
    int rows = math.min(logRows, strategy.closedtrades)
    for r = 0 to rows - 1
        int   ti  = strategy.closedtrades - 1 - r
        float pnl = strategy.closedtrades.profit(ti)
        float ep  = strategy.closedtrades.entry_price(ti)
        float xp  = strategy.closedtrades.exit_price(ti)
        float pct = ep != 0 ? (xp - ep) / ep * 100.0 : 0.0
        color bg  = pnl >= 0 ? color.new(color.green, 80) : color.new(color.red, 80)
        table.cell(blotter, 0, r + 1, str.tostring(ti + 1), text_size = size.tiny, bgcolor = bg)
        table.cell(blotter, 1, r + 1, str.tostring(ep, format.mintick), text_size = size.tiny, bgcolor = bg)
        table.cell(blotter, 2, r + 1, str.tostring(xp, format.mintick), text_size = size.tiny, bgcolor = bg)
        table.cell(blotter, 3, r + 1, f_money(pnl) + " (" + str.tostring(pct, "#.#") + "%)",
             text_size = size.tiny, bgcolor = bg)
        table.cell(blotter, 4, r + 1, str.tostring(strategy.closedtrades.exit_id(ti)), text_size = size.tiny, bgcolor = bg)

// ----------------------------------------------------------------------------
// Alerts
// ----------------------------------------------------------------------------
alertcondition(canWork and not canWork[1], "Order working",
     "RVOL gate passed; buy-stop working above the opening-range high.")
alertcondition(justEntered, "Long entry filled", "Long filled on the opening-range breakout.")
alertcondition(strategy.closedtrades > nz(strategy.closedtrades[1]), "Position closed",
     "Long closed. Check the blotter for the booked P&L.")
