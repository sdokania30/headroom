# Secrets only. Everything else belongs in config.yaml, which is safe to commit.
# Never commit this file.

# Claude - used by the sentiment engine.
ANTHROPIC_API_KEY=sk-ant-...

# DhanHQ - market data and order placement.
# Read-only usage (quotes) and order placement use the same token, so treat it
# as a live-trading credential regardless of what you intend to do with it.
DHAN_CLIENT_ID=1000000000
DHAN_ACCESS_TOKEN=eyJ...

# Any config field can also be overridden from the environment, e.g.
# NEWSALPHA__RISK__EQUITY=500000
# NEWSALPHA__SENTIMENT__MIN_CONFIDENCE=0.75
